{
  "name": "dailyflow",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host=0.0.0.0",
    "server": "tsx server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "build": "vite build && node scripts/verify-production-build.mjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/index.cjs --external:fsevents && node scripts/bundle-node.mjs && node scripts/bundle-lark-cli.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "check:version": "node scripts/check-version.mjs",
    "check:updater": "node --test scripts/generate-updater-manifest.node-test.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "bump": "node scripts/bump-version.mjs",
    "migrate:topic-spaces": "tsx server/scripts/migrate-to-topic-spaces.ts",
    "migrate:event-first": "tsx server/scripts/migrate-event-first.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xyflow/react": "^12.11.2",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "ulid": "^3.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@larksuite/cli": "1.0.78",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vite": "^6.2.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
