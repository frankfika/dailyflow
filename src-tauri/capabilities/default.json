{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the DailyFlow app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "process:default",
    "updater:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://github.com/*" },
        { "url": "https://*.github.com/*" },
        { "url": "https://feishu.cn/*" },
        { "url": "https://*.feishu.cn/*" },
        { "url": "https://accounts.google.com/*" },
        { "url": "https://console.cloud.google.com/*" }
      ]
    }
  ]
}
