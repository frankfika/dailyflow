# All VITE_* variables are inlined at build time. After changing any of
# them, restart the dev server (or rebuild the production bundle) for the
# new values to take effect.

# VITE_API_ORIGIN — only used in production / packaged Tauri builds.
# In dev, requests go through Vite's `/api` proxy (see VITE_API_PROXY_TARGET
# below) so this variable is ignored. The packaged app has no proxy and
# calls the bundled Express sidecar directly. Default: http://127.0.0.1:47832.
# Set this only if you changed the sidecar's listen port.
# VITE_API_ORIGIN=http://127.0.0.1:47832

# VITE_API_PROXY_TARGET — dev only. Overrides where Vite proxies `/api`.
# `npm run dev` pins Vite to 47831 (strictPort); the backend runs on 47832.
# `npm run dev:all` starts both.
# Important: do NOT hard-set this in your local `.env` if you also run
# Playwright — the e2e config sets `VITE_API_PROXY_TARGET=http://127.0.0.1:47842`
# to talk to a separate test server, and your `.env` would silently override
# it, sending e2e traffic to your dev backend.
# VITE_API_PROXY_TARGET=http://127.0.0.1:47832

GEMINI_API_KEY=